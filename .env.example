# API runtime
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
SESSION_SIGNING_SECRET=change-me-long-random-string
ADMIN_BOOTSTRAP_PASSWORD=333
COOKIE_NAME=art-site-session
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
COOKIE_PATH=/
COOKIE_DOMAIN=
SESSION_TTL_SECONDS=2592000
ADMIN_ALLOWED_ORIGINS=http://localhost:3001

# Object Storage
OBJECT_STORAGE_MODE=local
OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
OBJECT_STORAGE_REGION=ru-central1
OBJECT_STORAGE_BUCKET=art-site
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OBJECT_STORAGE_DATA_PREFIX=private/data
OBJECT_STORAGE_MEDIA_PREFIX=media
OBJECT_STORAGE_PUBLIC_SNAPSHOT_PREFIX=private/data/export
PUBLIC_SITE_SNAPSHOT_KEY=public-site.json

# Local fallback paths
LOCAL_RUNTIME_ROOT=.runtime-storage
LOCAL_PUBLIC_SNAPSHOT_FILE=.runtime-storage/export/public-site.json
LOCAL_MEDIA_ROOT=./public/uploads

# Static admin publish target
NEXT_PUBLIC_ADMIN_BASE_URL=http://localhost:3001
ADMIN_OBJECT_STORAGE_BUCKET=admin.art.solofarm.ru
